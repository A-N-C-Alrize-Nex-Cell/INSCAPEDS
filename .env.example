# --- Google Drive media integration -------------------------------------------
# Copy this file to `.env` and fill in the two values.
# `.env` is git-ignored; never commit real keys.

# Browser API key for the Google Drive API v3.
# Create at https://console.cloud.google.com/apis/credentials
# Restrict it to:
#   - API restriction:      Google Drive API only
#   - Application restriction: HTTP referrers -> your site's domain(s)
# (Read-only is implicit — this key is only ever used for files.list.)
VITE_DRIVE_API_KEY=

# ID of the shared root folder that contains Home/, About/, Projects/, ...
# It's the last path segment of the folder's URL:
#   https://drive.google.com/drive/folders/<THIS_IS_THE_ID>
# Share that folder (and everything under it) as "Anyone with the link – Viewer".
VITE_DRIVE_ROOT_FOLDER_ID=
